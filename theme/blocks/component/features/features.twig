{% set container_class_map = [ "grid-cols-1", "grid-cols-2", "grid-cols-3", "grid-cols-4", "grid-cols-5", "grid-cols-6", "grid-cols-7", "grid-cols-8", ] %}

{% set item_class_map_row_span = [ "row-span-1", "row-span-2", "row-span-3", "row-span-4", "row-span-5", "row-span-6", "row-span-7", "row-span-8", ] %}
{% set item_class_map_col_span = [ "col-span-1", "col-span-2", "col-span-3", "col-span-4", "col-span-5", "col-span-6", "col-span-7", "col-span-8", ] %}

{% set container_class = fields.grid_columns ? container_class_map[fields.grid_columns - 1] : "grid-cols-3" %}

<div class="grid max-lg:grid-cols-1 lg:grid-flow-col gap-8 {{ container_class }}">

    {% for item in fields.list %}

        {% set item_style = item.bg_color ? "background-color:" ~ item.bg_color ~ ";" : "" %}
        {% set item_style = item_style ~ " " ~ (item.color ? "color:" ~ item.color ~ ";" : "") %}

        {% set item_class = item.span_cols ? item_class_map_col_span[item.span_cols - 1] : "" %}
        {% set item_class = item_class ~ " " ~  (item.span_rows ? item_class_map_row_span[item.span_rows - 1] : "") %}

        <div class="bg-gray-100 max-lg:col-auto max-lg:row-auto p-8 rounded-xl  {{ item_class }}" style="{{ item_style }}"> 
            {% if item.icon %}
                <div class="bg-white rounded-full mb-20 size-14 text-blue-500 flex justify-center items-center">
                    {{ display_icon(item.icon) }}
                </div>
            {% endif %}

            <div class="font-bold mb-3">
                {{ item.title }}
            </div>
            {{ item.description }}
        </div>

    {% endfor %}

</div>
