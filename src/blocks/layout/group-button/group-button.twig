{#
/**
 * Block Name: Buttons Block
 *
 */
#}

{% set allowed_blocks = ['daeris/button'] %}
{% set inner_block_template = [
    [
        'daeris/button', 
        {
            'name' : 'daeris/button',
            'data' : {
                "link" : {
                    "url" : "#",
                    "title" : "Cliquer ici"
                },
                "style" : "btn-primary"
            },
            'mode' : 'auto',
        }
    ]
] %}

{% set alignClass = "justify-start" %}

{% if block.align == "center" %}

    {% set alignClass = "justify-center" %}

{% elseif block.align == "right" %}

    {% set alignClass = "justify-end" %}

{% endif %}

{% set gridClass = "" %}

{% if fields.mobile_full_width %}

    {% set gridClass = "w-full flex-col md:flex-wrap md:flex-row items-stretch md:items-center" %}

{% else %}

    {% set gridClass = "flex-wrap items-stretch md:items-center" %}

{% endif %}

<div id="{{ id }}" class="{{ class }} ">

    <InnerBlocks class="flex gap-6 {{ gridClass }} {{alignClass}}" template="{{ inner_block_template|json_encode|esc_attr }}" allowedblocks="{{ allowed_blocks|json_encode|esc_attr }}"/>

</div>
