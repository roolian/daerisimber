<div class="relative overflow-clip">
    <div class="row justify-center items-center relative z-10">
        <div class="col  md:w-6/12 ">
            <div class="py-20 md:py-30">
                 <h1 class="h1 mb-6">
                    {{ fields.title|striptags('<strong><br>') }}
                </h1>

                {% if fields.subtitle %}
                    <div class="mb-10">
                        {{ fields.subtitle }}
                    </div>
                {% endif %}
                <InnerBlocks class="mt-10"/>

            </div>
        </div>

        {% if fields.image %}
            <div class="col md:w-6/12">
                <div class="flex justify-center">
                    <img src="{{ get_image(fields.image).src }}" alt="" class="bg-gray-50">
                </div>
            </div>
        {% endif %}
    </div>
</div>
