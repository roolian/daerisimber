{#
/**
 * Block Name: Bullet List Block has-primary-light-background-color
 *
 */
#}

{% if fields.type == "col" %}
    {% set class_type = "columns-1 space-y-3 gap-x-8" %}

    {% if fields.col_number == 2 %}

        {% set class_type = class_type ~ " md:columns-2" %}

    {% endif %}

{% else %}
    {% set class_type = "grid grid-cols-1  gap-x-8 gap-y-6" %}

    {% if fields.col_number == 2 %}

        {% set class_type = class_type ~ " md:grid-cols-2 " %}

    {% endif %}

{% endif %}

{% if not(fields.list) %}
    <div class="italic">
        Ajoutez des éléments dans la liste
    </div>
{% endif %}

<div id="{{ id }}" class="{{ class }}">
    {% include [variant_path ~ fields.variant, variant_path ~ 'default.twig'] ignore missing %}
</div>
