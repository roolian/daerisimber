{#
/**
 * Block Name: Post list
 */
#}

<div id="{{ id }}" class="{{ class }}">
    {% if(is_preview) %}
        <div class="absolute inset-0 z-50"></div>
    {% endif %}
    <div data-ajax-action="drs_post_list_block_load_more_posts" data-ajax-injection="append" data-ajax-form=".post-list-form" data-ajax-update=".wrapper" data-ajax-trigger=".read-more">

        <form method="post" class="post-list-form">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="block_id" value="{{ block.id }}">
            <input type="hidden" name="post_id" value="{{ post_id }}">
        </form>

        <div class="flex flex-wrap ">

            <div class="wrapper w-full">

                {% include block.path ~ "/partial/post-list-loop.twig" with {'posts' : posts, 'post_type': 'post',  'columns' : fields.columns}  %}

            </div>
        </div>

            <div class="my-8 post-list-pagination">
                {{ include('partial/pagination.twig', { prev_next:false, pagination: posts.pagination({show_all: false, mid_size: 3, end_size: 2}) })  }}
            </div>



    </div>

</div>